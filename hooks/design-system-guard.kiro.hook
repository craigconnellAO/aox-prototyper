{
  "enabled": true,
  "name": "Design System Guard",
  "description": "When an HTML prototype is saved, check for hand-drawn <svg> icons and raw hex colour values instead of Strata icon-font classes and design.md tokens. This is a warning, not a block — it exists because Claude has repeatedly hand-drawn icons and grabbed the wrong header/logo instead of pulling from the authoritative component sheet (see steering/ao-design-system.md, Protocol 1: resolve-before-build).",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "**/*.html"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Check the file that was just saved for two known failure modes: (1) inline hand-drawn <svg> elements standing in for an icon that exists in the Strata icon font — see assets/strata-component-sheet/index.html for the real icon markup; (2) raw hex colour values in inline style attributes or <style> blocks where a steering/design.md token should be used instead. If either is found, flag the specific lines to the user and suggest the correct Strata icon class or design.md token — do not silently fix it."
  }
}
